{
  "name": "zhitu-atlas-desktop",
  "version": "0.22.1",
  "description": "求职工作台 · 岗位匹配、全局分析与沟通管理",
  "main": "./out/main/index.js",
  "author": "Zhengfa Dong",
  "productName": "职途 Atlas",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "web:build": "vite build --config web/vite.config.mjs",
    "web:serve": "node web/serve.mjs",
    "build:linux": "electron-builder --linux dir"
  },
  "dependencies": {
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@unocss/preset-attributify": "^0.58.5",
    "@unocss/preset-icons": "^0.58.5",
    "@unocss/preset-uno": "^0.58.5",
    "@vitejs/plugin-vue": "^5.0.3",
    "electron": "39.2.7",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "element-plus": "^2.8.4",
    "prettier": "^3.2.4",
    "sass": "^1.70.0",
    "typescript": "^5.3.3",
    "unocss": "^0.58.5",
    "vite": "^5.0.12",
    "vue": "^3.5.11",
    "vue-router": "^4.2.5",
    "vue-tsc": "^1.8.27",
    "@types/leaflet": "1.9.20",
    "pinia": "^3.0.2",
    "leaflet": "1.9.4"
  },
  "license": "ISC"
}
