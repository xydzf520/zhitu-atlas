    "test": "node scripts/atlas-project.mjs test",
    "typecheck": "node scripts/atlas-project.mjs typecheck",
    "check:public": "node scripts/atlas-public-check.cjs",
    "check:public:history": "node scripts/atlas-public-check.cjs --history",
    "check:runtime": "node scripts/atlas-runtime-audit.cjs",
    "licenses:collect": "node scripts/atlas-licenses.cjs",
    "check:licenses:web": "node scripts/atlas-license-web-check.mjs",
    "check": "node scripts/atlas-project.mjs check",
    "web": "node scripts/atlas-project.mjs web",
    "test:communication": "node --test tests/communication-quality.test.cjs tests/communication-reply.test.cjs tests/greeting.test.cjs tests/dashboard.test.cjs tests/hiring-guide.test.cjs",
    "eval:communication": "node scripts/atlas-communication-suite.cjs"
